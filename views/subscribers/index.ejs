<h2>Liste des abonnés</h2>
<table class="table">
<thead>
<tr>
<th>Nom</th>
<th>Email</th>
<th>Code Postal</th>
</tr>
</thead>
<tbody>
<% subscribers.forEach(subscriber => { %>
<tr>
<td><a href="<%= `/subscribers/${subscriber._id}` %>"><%= subscriber.name %></a></td>
<td><%= subscriber.email %></td>
<td><%= subscriber.zipCode %></td>
</tr>
<% }); %>
</tbody>
</table>
<button onclick="window.location.href='/subscribers/new';" style="background-color: blue; color: white; padding: 10px 20px; border: none; border-radius: 5px;">
    Créer un nouvel abonné
  </button>
  

